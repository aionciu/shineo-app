{
  "expo": {
    "name": "Shineo",
    "slug": "shineo-app",
    "version": "1.0.0",
    "scheme": "shineo",
    "sdkVersion": "56.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2DC653"
        }
      ],
      "expo-localization",
      "@react-native-google-signin/google-signin"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shineo.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.shineo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#2DC653"
      }
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5f9780d2-9027-494e-aff5-badae76a1e28"
      }
    },
    "owner": "minimus"
  }
}
